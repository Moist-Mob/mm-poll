{% comment %}
  identity only: logo, site name, site-wide links (admin's Create, everyone's
  Nominate), and who's logged in. Per-poll actions live in the poll-title
  partial instead.
{% endcomment %}
<div class="min-h-[3rem] flex flex-row flex-wrap items-center gap-x-4 gap-y-1 px-3 text-zinc-300 bg-zinc-800">
  <a
    href="/"
    tabindex="9"
    class="self-stretch flex flex-row items-center gap-x-4 mr-2 sm:mr-6 hover:text-zinc-100">
    <img src="/img/dnkHappy.png" class="w-10 h-10 self-end shrink-0">
    <h2 class="text-lg my-0 whitespace-nowrap">Moist Polls</h2>
  </a>
  {% comment %} Nominate first, so it sits in the same spot for everyone {% endcomment %}
  <a
    tabindex="9"
    class="py-3 hover:text-zinc-100"
    href="/nominate">Nominate</a>
  {% if admin %}
    <a
      tabindex="9"
      class="py-3 hover:text-zinc-100"
      href="/create">Create</a>
  {% endif %}
  <div class="ml-auto flex flex-row items-center gap-x-1 whitespace-nowrap">
    {% if user %}
      <span>{{ user.login | escape }}</span>
      <span class="mx-1">|</span>
      <a
        tabindex="10"
        class="py-3 px-1 hover:text-zinc-100"
        href="/auth/logout">Log out</a>
    {% else %}
      <a
        tabindex="10"
        class="py-3 px-1 hover:text-zinc-100"
        href="/auth/login">
        <span class="inline-block w-4 h-4 relative top-[2px] [&_.st0]:fill-white [&_.st1]:fill-twitch-purple">
<!-- esthetic-ignore-next-->
         <svg version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" viewBox="0 0 2400 2800" style="enable-background:new 0 0 2400 2800;" xml:space="preserve"><g><polygon class="st0" points="2200,1300 1800,1700 1400,1700 1050,2050 1050,1700 600,1700 600,200 2200,200 	" /><g><g id="Layer_1-2"><path class="st1" d="M500,0L0,500v1800h600v500l500-500h400l900-900V0H500z M2200,1300l-400,400h-400l-350,350v-350H600V200h1600 V1300z" /><rect x="1700" y="550" class="st1" width="200" height="600" /><rect x="1150" y="550" class="st1" width="200" height="600" /></g></g></g></svg>
        </span>
        <span>Log in</span>
      </a>
    {% endif %}
  </div>
</div>
