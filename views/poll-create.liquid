{% layout "default" %}

{% block content %}
  <h1 class="mb-2">Create poll</h1>
  <p>Pick a poll type, then supply a title and one or more entries below. Click the
<!-- esthetic-ignore-next -->
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4 inline-block">
    <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25Zm-1.72 6.97a.75.75 0 1 0-1.06 1.06L10.94 12l-1.72 1.72a.75.75 0 1 0 1.06 1.06L12 13.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L13.06 12l1.72-1.72a.75.75 0 1 0-1.06-1.06L12 10.94l-1.72-1.72Z" clip-rule="evenodd" />
  </svg>
    icon to remove an item and Create when done. Tip: Press Return to create new entries easily.</p>
  <ul class="text-sm">
    <li><b>Ranked vote</b> (instant runoff): viewers rank the options; one winner is chosen by elimination rounds.</li>
    <li><b>Kano poll</b>: viewers rate how they'd feel with and without each item; results show how the audience splits (want it / don't mind / don't want it) and sum up each item as taken for granted, wanted, a bonus, doesn't matter, or better without.</li>
  </ul>
  <p class="text-sm">For a Kano poll, name each item as a <b>thing</b>, not a change: "Pineapple on pizza", not "Adding pineapple to pizza". Viewers are asked how they'd feel with it and without it, so the results work for both adding and removing something — but naming a change flips every answer's meaning.</p>

  <form
    id="option-form"
    class="min-w-30 flex flex-col"
    method="post"
    action="/create"
    autocomplete="off">
    <input
      type="hidden"
      name="csrf-token"
      value="{{ localId | escape }}">
    <div class="flex flex-col gap-2 px-6 py-8 bg-sky-700 rounded-xl">

      <div class="flex flex-row flex-wrap gap-x-6 gap-y-1 mb-2 text-zinc-100">
        <label class="cursor-pointer">
          <input
            type="radio"
            name="kind"
            value="irv"
            tabindex="1"
            checked>
          Ranked vote
        </label>
        <label class="cursor-pointer">
          <input
            type="radio"
            name="kind"
            value="kano"
            tabindex="1">
          Kano poll
        </label>
      </div>

      <input
        id="title"
        name="title"
        class="allow-blur w-full shadow appearance-none border rounded py-2 px-3 mb-2 text-zinc-600 focus-within:text-zinc-900 leading-tight focus:outline-none focus:shadow-outline"
        autofocus
        tabindex="1"
        type="text"
        data-placeholder-irv="Title (e.g. What should I play next?)"
        data-placeholder-kano="Title (e.g. Which stream segments should I keep?)"
        placeholder="Title (e.g. What should I play next?)">

      <div id="options" class="flex flex-col gap-2">
        <!-- rows are cloned from the template below; one is rendered up front -->
        <div class="poll-option flex flex-row gap-2">
          <input
            class="allow-blur w-full shadow appearance-none border rounded py-2 px-3 text-zinc-600 focus-within:text-zinc-900 leading-tight focus:outline-none focus:shadow-outline"
            type="text"
            name="option[]"
            data-placeholder-irv="Option (e.g. Doki Doki Literature Club)"
            data-placeholder-kano="Feature (e.g. Viewer-submitted challenges)"
            placeholder="Option (e.g. Doki Doki Literature Club)"
            tabindex="1">
          <button
            type="button"
            class="remove-row allow-blur w-6 h-6 py-2 hover:text-orange-400 focus:outline-none focus:text-orange-400"
            tabindex="1"
            aria-label="Remove this row">
<!-- esthetic-ignore-next -->
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6 pointer-events-none">
              <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25Zm-1.72 6.97a.75.75 0 1 0-1.06 1.06L10.94 12l-1.72 1.72a.75.75 0 1 0 1.06 1.06L12 13.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L13.06 12l1.72-1.72a.75.75 0 1 0-1.06-1.06L12 10.94l-1.72-1.72Z" clip-rule="evenodd" />
            </svg>
          </button>
        </div>
      </div>

      <button
        id="new-row"
        class="allow-blur font-bold py-2 px-6 mt-2 w-full rounded-lg text-zinc-800 bg-zinc-300 hover:bg-zinc-400 focus:outline-none focus:bg-zinc-400"
        tabindex="2"
        type="button">New row</button>
    </div>

    <button
      class="font-bold py-3 px-12 mt-12 mx-auto rounded-lg text-white bg-orange-500 hover:bg-orange-400 focus:outline-none focus:bg-orange-400"
      tabindex="2"
      type="submit">Create Poll</button>
  </form>

  <script type="text/javascript">
    {% raw %}
    (function () {
      'use strict';

      const form = document.getElementById('option-form');
      const options = document.getElementById('options');
      // the first row doubles as the template for new ones
      const rowTemplate = options.querySelector('.poll-option').cloneNode(true);

      const rows = () => Array.from(options.querySelectorAll('.poll-option'));
      const inputOf = row => row.querySelector('input');

      const focusRow = row => {
        if (!row) return false;
        inputOf(row).focus();
        return true;
      };

      const focusEmpty = () => focusRow(rows().find(row => inputOf(row).value.trim() === ''));

      const newRow = () => {
        if (focusEmpty()) return;
        const row = rowTemplate.cloneNode(true);
        inputOf(row).value = '';
        options.appendChild(row);
        applyKind();
        focusRow(row);
      };

      const removeRow = row => {
        const all = rows();
        const idx = all.indexOf(row);
        row.remove();
        const remaining = rows();
        if (remaining.length === 0) {
          newRow();
        } else if (!focusRow(remaining[idx]) && !focusRow(remaining[remaining.length - 1])) {
          focusEmpty();
        }
      };

      // placeholders differ by poll type
      const applyKind = () => {
        const checked = Array.from(form.querySelectorAll('input[name="kind"]')).find(r => r.checked);
        const kind = checked ? checked.value : 'irv';
        form.querySelectorAll('input[data-placeholder-irv]').forEach(input => {
          input.placeholder = input.dataset['placeholder' + (kind === 'kano' ? 'Kano' : 'Irv')];
        });
      };

      form.addEventListener('change', ev => {
        if (ev.target.name === 'kind') applyKind();
      });

      options.addEventListener('click', ev => {
        const btn = ev.target.closest('button.remove-row');
        if (btn) {
          ev.preventDefault();
          removeRow(btn.closest('.poll-option'));
        }
      });

      document.getElementById('new-row').addEventListener('click', ev => {
        ev.preventDefault();
        newRow();
      });

      // Return in a text field moves to the next empty row (creating one if
      // needed) instead of submitting the form
      form.addEventListener('keydown', ev => {
        if (ev.key !== 'Enter' || ev.target.type !== 'text') return;
        ev.preventDefault();
        if (ev.target.value === '') return;
        if (focusEmpty()) return;
        newRow();
      });

      applyKind();
    })();
    {% endraw %}
  </script>
{% endblock %}
