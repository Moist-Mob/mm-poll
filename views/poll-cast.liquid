{% layout "default" %}

{% block content %}

  {% render "poll-title"
    , title: poll.title
    , remaining: remaining
    , poll: poll
    , admin: admin
    , localId: localId %}

  <p>Tap the options in order of preference, your favorite first. You don't have to rank everything; anything you leave below the line is simply not counted. Tap a ranked item to remove it, or use the arrows to nudge it.</p>

  <form
    id="submit-vote"
    method="post"
    action="/vote"
    class="flex flex-col min-w-30 gap-4">
    <input
      type="hidden"
      name="csrf-token"
      value="{{ localId | escape }}">
    <input
      type="hidden"
      name="poll_id"
      value="{{ poll.poll_id | escape }}">

    {% comment %}
      row / chosen / pick / badge / arrows / up / down / divider / divider-text
      are hooks for the script below, not styles. The script toggles "chosen"
      on a row; the group-[.chosen] variants style the row's children from it.
      No vertical padding + overflow-hidden so the first ranked row fills the
      rounded top corners.
    {% endcomment %}
    <ol id="ballot" class="my-0 p-0 w-full list-none overflow-hidden bg-zinc-900/50 rounded-xl [&>li]:my-0">
      <li class="divider flex items-center px-4 py-2 text-sm text-zinc-300/80 border-b-2 border-dashed border-zinc-100/25" data-count="0" aria-hidden="true">
        <span class="divider-text"></span>
      </li>
      {% for option in poll.options %}
        <li class="row group flex flex-row items-stretch gap-1 px-2 border-b border-zinc-100/10 last:border-b-0 [&.chosen]:bg-sky-700" data-option-id="{{ option.option_id | escape }}">
          <button type="button" class="pick flex flex-row items-center gap-3 flex-1 min-h-[3rem] px-2 py-2 text-left text-zinc-200 rounded-md group-[:not(.chosen)]:hover:bg-zinc-100/10" aria-pressed="false">
            <span class="badge inline-flex items-center justify-center shrink-0 w-7 h-7 rounded-full border-2 border-zinc-400/60 text-sm font-bold group-[.chosen]:bg-orange-500 group-[.chosen]:border-orange-500 group-[.chosen]:text-white" aria-hidden="true"></span>
            <span class="name">{{ option.name | escape }}</span>
          </button>
          <span class="arrows flex flex-row items-center gap-1 group-[:not(.chosen)]:hidden">
            <button type="button" class="up flex items-center justify-center w-10 min-h-[2.75rem] rounded-md text-zinc-200 hover:bg-sky-900 hover:text-white disabled:opacity-25 disabled:hover:bg-transparent" aria-label="Move {{ option.name | escape }} up" disabled>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5" aria-hidden="true"><path fill-rule="evenodd" d="M14.77 12.79a.75.75 0 0 1-1.06-.02L10 8.832 6.29 12.77a.75.75 0 1 1-1.08-1.04l4.25-4.5a.75.75 0 0 1 1.08 0l4.25 4.5a.75.75 0 0 1-.02 1.06Z" clip-rule="evenodd" /></svg>
            </button>
            <button type="button" class="down flex items-center justify-center w-10 min-h-[2.75rem] rounded-md text-zinc-200 hover:bg-sky-900 hover:text-white disabled:opacity-25 disabled:hover:bg-transparent" aria-label="Move {{ option.name | escape }} down" disabled>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" /></svg>
            </button>
          </span>
        </li>
      {% endfor %}
    </ol>

    <button class="font-bold py-3 px-12 mt-4 mx-auto rounded-lg text-white bg-orange-500 hover:bg-orange-400 focus:outline-none focus:bg-orange-400" type="submit">Submit</button>

  </form>

  <script type="text/javascript">
    {% raw %}
    (function () {
      'use strict';

      const list = document.getElementById('ballot');
      const divider = list.querySelector('.divider');
      const dividerText = divider.querySelector('.divider-text');
      const form = document.getElementById('submit-vote');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ranked rows are everything above the divider, in order
      const ranked = () => {
        const out = [];
        for (let el = list.firstElementChild; el !== null && el !== divider; el = el.nextElementSibling) {
          out.push(el);
        }
        return out;
      };

      const renumber = () => {
        const rows = ranked();
        rows.forEach((row, i) => {
          row.classList.add('chosen');
          row.querySelector('.pick').setAttribute('aria-pressed', 'true');
          row.querySelector('.badge').textContent = String(i + 1);
          row.querySelector('.up').disabled = i === 0;
          row.querySelector('.down').disabled = i === rows.length - 1;
        });
        for (let el = divider.nextElementSibling; el !== null; el = el.nextElementSibling) {
          el.classList.remove('chosen');
          el.querySelector('.pick').setAttribute('aria-pressed', 'false');
          el.querySelector('.badge').textContent = '';
          el.querySelector('.up').disabled = true;
          el.querySelector('.down').disabled = true;
        }
        const n = rows.length;
        const remaining = list.querySelectorAll('li.row').length - n;
        divider.dataset.count = String(n);
        dividerText.textContent =
          n === 0
            ? 'Tap your favorite to start ranking'
            : remaining === 0
              ? 'All ' + n + ' ranked · tap an item to remove it'
              : n + ' ranked · tap more below to add them';
      };

      // FLIP: make a DOM change, then animate every row from where it was to where it is
      const animate = change => {
        if (reduceMotion) {
          change();
          return;
        }
        const rows = Array.from(list.children);
        const before = new Map(rows.map(el => [el, el.getBoundingClientRect().top]));
        change();
        for (const el of rows) {
          const delta = before.get(el) - el.getBoundingClientRect().top;
          if (delta === 0) continue;
          el.style.transition = 'none';
          el.style.transform = 'translateY(' + delta + 'px)';
        }
        // force a reflow so the transform above is the starting state
        void list.offsetHeight;
        for (const el of rows) {
          el.style.transition = 'transform 200ms ease-out';
          el.style.transform = '';
        }
      };

      list.addEventListener('click', ev => {
        const btn = ev.target.closest('button');
        if (!btn || !list.contains(btn)) return;
        const row = btn.closest('li.row');
        if (!row) return;
        ev.preventDefault();

        if (btn.classList.contains('up')) {
          const prev = row.previousElementSibling;
          if (prev && prev !== divider) animate(() => list.insertBefore(row, prev));
        } else if (btn.classList.contains('down')) {
          const next = row.nextElementSibling;
          if (next && next !== divider) animate(() => list.insertBefore(next, row));
        } else if (row.classList.contains('chosen')) {
          // unrank: park it just below the divider so it's easy to re-tap
          animate(() => list.insertBefore(row, divider.nextElementSibling));
        } else {
          // rank: append to the ranked section
          animate(() => list.insertBefore(row, divider));
        }
        renumber();
      });

      list.addEventListener('transitionend', ev => {
        if (ev.target instanceof HTMLElement) ev.target.style.transition = '';
      });

      form.addEventListener('submit', ev => {
        form.querySelectorAll('input[name^="ranks["]').forEach(el => el.remove());
        const rows = ranked();
        if (rows.length === 0) {
          ev.preventDefault();
          alert('Rank at least one option!');
          return;
        }
        rows.forEach((row, i) => {
          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = 'ranks[' + i + ']';
          input.value = row.dataset.optionId;
          form.appendChild(input);
        });
      });

      renumber();
    })();
    {% endraw %}
  </script>
{% endblock %}
